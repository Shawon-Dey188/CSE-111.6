#include <stdio.h>

int main() {
    int n, i, Prime = 1;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

for (i = 2; i <= n / 2; i++) 
  if (n % i == 0)
  {
      Prime = 0;
      break;
  }
        

    if (Prime == 1) {
        printf("%d is a Prime number.\n", n);
    } else {
        printf("%d is NOT a Prime number.\n", n);
    }

    return 0;
}
